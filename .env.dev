# Скопируйте в .env (рабочий бот) и .env.dev (тестовый бот), заполните значения.
# Описание переменных — docs/03_architecture.md, раздел 7.

BOT_TOKEN=123456789:replace-with-token-from-botfather
DATABASE_URL=postgresql+asyncpg://pochvasvet:change-me@db:5432/pochvasvet
REDIS_URL=redis://redis:6379/0
ADMIN_IDS=111111111
WEBAPP_URL=
TZ_DEFAULT=Europe/Minsk
LOG_LEVEL=INFO
RULES_PATH=rules/rules.json

# v2
AGRONOMIST_FALLBACK_CHAT_ID=
CALIBRATION_DIR=rules/calibration
PHOTO_STORAGE_DIR=/data/photos
LOG_HASH_SALT=change-me-random-string

# v3
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Необязательно: webhook вместо polling
WEBHOOK_URL=
WEBHOOK_SECRET=

# Для docker-compose (сервис db)
POSTGRES_USER=pochvasvet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pochvasvet
